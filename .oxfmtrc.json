{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"useTabs": true,
	"singleQuote": true,
	"trailingComma": "none",
	"printWidth": 100,
	"sortPackageJson": false,
	"ignorePatterns": [
		"node_modules",
		".next",
		"out",
		"package.json",
		"pnpm-lock.yaml",
		"tsconfig.json",
		".gitignore"
	]
}
